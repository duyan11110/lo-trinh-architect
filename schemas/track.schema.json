{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/track.schema.json",
  "title": "track.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "skills",
    "levels"
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackId": {
      "type": "string",
      "enum": [
        "foundation",
        "design",
        "backend",
        "frontend",
        "devops",
        "k8s",
        "management",
        "sysdesign"
      ]
    },
    "lessonId": {
      "type": "string",
      "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "skillId": {
      "type": "string",
      "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "term": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/trackId"
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "description": {
      "$ref": "#/$defs/i18n"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/skillId"
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "prereqs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/skillId"
            },
            "default": []
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "title",
          "modules"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "stage",
                "lessons"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/slug"
                },
                "title": {
                  "$ref": "#/$defs/i18n"
                },
                "stage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "summary": {
                  "$ref": "#/$defs/i18n"
                },
                "lessons": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "main_path",
                      "duration_min",
                      "skills",
                      "prereqs",
                      "vocab",
                      "example_tag",
                      "outline",
                      "misconceptions",
                      "related"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/lessonId"
                      },
                      "title": {
                        "$ref": "#/$defs/i18n"
                      },
                      "main_path": {
                        "type": "boolean"
                      },
                      "duration_min": {
                        "type": "integer",
                        "minimum": 6,
                        "maximum": 20
                      },
                      "skills": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": {
                          "$ref": "#/$defs/skillId"
                        }
                      },
                      "prereqs": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                          "$ref": "#/$defs/lessonId"
                        }
                      },
                      "related": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "$ref": "#/$defs/lessonId"
                        },
                        "default": []
                      },
                      "vocab": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "$ref": "#/$defs/term"
                        }
                      },
                      "example_tag": {
                        "type": "string",
                        "pattern": "^stage-[0-4]$"
                      },
                      "example_files": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                          "type": "string"
                        },
                        "default": []
                      },
                      "outline": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "minLength": 10,
                          "maxLength": 240
                        }
                      },
                      "misconceptions": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 4,
                        "items": {
                          "type": "string",
                          "minLength": 10,
                          "maxLength": 200
                        }
                      },
                      "depth_notes": {
                        "type": "string",
                        "maxLength": 300
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}