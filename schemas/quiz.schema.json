{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/quiz.schema.json",
  "title": "Lesson quiz (.quiz.json) and gate bank (gateN.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "properties": {
    "lesson": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "pattern": "^gate[0-4]$"
    },
    "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "lesson",
        "stage"
      ],
      "not": {
        "required": [
          "gate"
        ]
      }
    },
    {
      "required": [
        "gate",
        "stage"
      ],
      "not": {
        "required": [
          "lesson"
        ]
      }
    }
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "explanationLang": {
      "type": "object",
      "required": [
        "correct"
      ],
      "properties": {
        "correct": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 20
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vi",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f]$"
        },
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "misconception": {
          "type": "string",
          "minLength": 10
        },
        "polarity": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bloom",
        "difficulty",
        "skills",
        "question",
        "answer",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^([a-z0-9.-]+\\.q[0-9]+|gate[0-4]\\.q[0-9]+)$"
        },
        "type": {
          "type": "string",
          "enum": [
            "single",
            "multi",
            "truefalse",
            "order",
            "fill",
            "scenario"
          ]
        },
        "bloom": {
          "type": "string",
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate"
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "track": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "section_ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "context": {
          "$ref": "#/$defs/i18n"
        },
        "question": {
          "$ref": "#/$defs/i18n"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_regex": {
          "type": "string"
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vi",
            "en"
          ],
          "properties": {
            "vi": {
              "$ref": "#/$defs/explanationLang"
            },
            "en": {
              "$ref": "#/$defs/explanationLang"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multi"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 6
              },
              "answer": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "truefalse"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "order"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 3,
                "maxItems": 6
              },
              "answer": {
                "minItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "context"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              },
              "bloom": {
                "enum": [
                  "apply",
                  "analyze",
                  "evaluate"
                ]
              }
            }
          }
        }
      ]
    }
  }
}