{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/path.schema.json",
  "title": "path.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stages"
  ],
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "title",
          "gate",
          "modules"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "gate": {
            "type": "string",
            "pattern": "^gate[0-4]$"
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)/[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}