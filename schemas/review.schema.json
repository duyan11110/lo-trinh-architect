{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/review.schema.json",
  "title": "Lesson review (.review.json) — written by prompts 04 and 05",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_at",
        "reviewer",
        "claim_verdicts",
        "issues",
        "scope",
        "verdict"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "type": "string"
        },
        "claim_verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "verdict",
              "evidence"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "verified",
                  "rephrased",
                  "wrong",
                  "unverified",
                  "not-needed"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 10,
                "maxLength": 600
              },
              "source": {
                "type": "string",
                "maxLength": 300
              },
              "suggested_text": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outline_covered",
            "beyond_scope"
          ],
          "properties": {
            "outline_covered": {
              "type": "boolean"
            },
            "beyond_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fix-required",
            "rewrite"
          ]
        }
      }
    },
    "junior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_at",
        "reviewer",
        "issues",
        "readability",
        "verdict"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "readability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown_terms",
            "skipped_steps",
            "situation_connects",
            "try_it_feasible",
            "summary_matches"
          ],
          "properties": {
            "unknown_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipped_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "situation_connects": {
              "type": "boolean"
            },
            "try_it_feasible": {
              "type": "boolean"
            },
            "summary_matches": {
              "type": "boolean"
            }
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fix-required",
            "rewrite"
          ]
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "section",
        "kind",
        "text",
        "fix"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        },
        "section": {
          "type": [
            "integer",
            "string"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "accuracy",
            "version",
            "code",
            "scope",
            "opinion-as-fact",
            "term",
            "gap",
            "example",
            "diagram",
            "quiz",
            "style",
            "length"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 15,
          "maxLength": 600
        },
        "fix": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "quote": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  },
  "description": "technical và junior có thể được ghi ở hai thời điểm khác nhau bởi hai reviewer; validate R01 chỉ yêu cầu đủ cả hai khi bài có status >= reviewed."
}