{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/glossary.schema.json",
  "title": "glossary.yaml",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "term",
      "en",
      "vi_keep",
      "vi",
      "short_vi",
      "short_en",
      "introduced_in"
    ],
    "properties": {
      "term": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "en": {
        "type": "string"
      },
      "vi_keep": {
        "type": "boolean"
      },
      "vi": {
        "type": "string"
      },
      "short_vi": {
        "type": "string",
        "maxLength": 140
      },
      "short_en": {
        "type": "string",
        "maxLength": 140
      },
      "introduced_in": {
        "type": "string",
        "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 6
      }
    }
  }
}