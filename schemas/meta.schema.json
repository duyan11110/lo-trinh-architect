{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/meta.schema.json",
  "title": "Lesson sidecar (.meta.json) — claims and self-check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "generated_by",
    "generated_at",
    "claims",
    "coverage",
    "self_check"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "text",
          "kind",
          "needs_verification"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 15,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "behavior",
              "number",
              "syntax",
              "opinion",
              "history"
            ]
          },
          "version_key": {
            "type": "string"
          },
          "source_hint": {
            "type": "string",
            "maxLength": 200
          },
          "needs_verification": {
            "type": "boolean"
          },
          "section": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "behavior",
                    "number",
                    "syntax",
                    "history"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "needs_verification": {
                  "const": true
                }
              },
              "required": [
                "source_hint"
              ]
            }
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline_items_covered",
        "outline_items_missing",
        "beyond_scope"
      ],
      "properties": {
        "outline_items_covered": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "outline_items_missing": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "beyond_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_concept",
        "vocab_all_defined",
        "code_from_repo",
        "no_external_urls",
        "word_count"
      ],
      "properties": {
        "one_concept": {
          "type": "boolean"
        },
        "vocab_all_defined": {
          "type": "boolean"
        },
        "code_from_repo": {
          "type": "boolean"
        },
        "no_external_urls": {
          "type": "boolean"
        },
        "word_count": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo_changes_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "need"
        ],
        "properties": {
          "lesson": {
            "type": "string"
          },
          "need": {
            "type": "string"
          },
          "suggested_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}