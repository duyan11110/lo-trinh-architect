{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/content.schema.json",
  "title": "dist/content.json (đầu ra tools/build, đầu vào app)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "path",
    "tracks",
    "lessons",
    "quizzes",
    "gates",
    "glossary",
    "skills"
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "heading",
        "md"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "heading": {
          "type": "string"
        },
        "md": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bloom",
        "difficulty",
        "skills",
        "question",
        "answer",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^([a-z0-9.-]+\\.q[0-9]+|gate[0-4]\\.q[0-9]+)$"
        },
        "type": {
          "type": "string",
          "enum": [
            "single",
            "multi",
            "truefalse",
            "order",
            "fill",
            "scenario"
          ]
        },
        "bloom": {
          "type": "string",
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate"
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "track": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "section_ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "context": {
          "$ref": "#/$defs/i18n"
        },
        "question": {
          "$ref": "#/$defs/i18n"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_regex": {
          "type": "string"
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vi",
            "en"
          ],
          "properties": {
            "vi": {
              "$ref": "#/$defs/explanationLang"
            },
            "en": {
              "$ref": "#/$defs/explanationLang"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multi"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 6
              },
              "answer": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "truefalse"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "order"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 3,
                "maxItems": 6
              },
              "answer": {
                "minItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "context"
            ],
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "answer": {
                "maxItems": 1
              },
              "bloom": {
                "enum": [
                  "apply",
                  "analyze",
                  "evaluate"
                ]
              }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vi",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f]$"
        },
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "misconception": {
          "type": "string",
          "minLength": 10
        },
        "polarity": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "explanationLang": {
      "type": "object",
      "required": [
        "correct"
      ],
      "properties": {
        "correct": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 20
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_version",
        "built_at",
        "versions",
        "langs"
      ],
      "properties": {
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "built_at": {
          "type": "string"
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "langs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ]
          }
        }
      }
    },
    "path": {
      "stages": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "title",
            "gate",
            "modules"
          ],
          "properties": {
            "stage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "title": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vi",
                "en"
              ],
              "properties": {
                "vi": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              }
            },
            "gate": {
              "type": "string",
              "pattern": "^gate[0-4]$"
            },
            "outcome": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vi",
                "en"
              ],
              "properties": {
                "vi": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              }
            },
            "modules": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)/[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "title",
                "modules"
              ],
              "properties": {
                "level": {
                  "type": "integer"
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vi",
                    "en"
                  ],
                  "properties": {
                    "vi": {
                      "type": "string"
                    },
                    "en": {
                      "type": "string"
                    }
                  }
                },
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "stage",
                      "lessons"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "vi",
                          "en"
                        ],
                        "properties": {
                          "vi": {
                            "type": "string"
                          },
                          "en": {
                            "type": "string"
                          }
                        }
                      },
                      "stage": {
                        "type": "integer"
                      },
                      "summary": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "vi",
                          "en"
                        ],
                        "properties": {
                          "vi": {
                            "type": "string"
                          },
                          "en": {
                            "type": "string"
                          }
                        }
                      },
                      "lessons": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "title",
                            "main_path",
                            "duration_min"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "title": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "vi",
                                "en"
                              ],
                              "properties": {
                                "vi": {
                                  "type": "string"
                                },
                                "en": {
                                  "type": "string"
                                }
                              }
                            },
                            "main_path": {
                              "type": "boolean"
                            },
                            "duration_min": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "lessons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "track",
          "level",
          "stage",
          "module",
          "main_path",
          "duration_min",
          "title",
          "skills",
          "prereqs",
          "related",
          "vocab",
          "example_tag",
          "sections",
          "diagram_svg",
          "skip_note",
          "content_version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "track": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "stage": {
            "type": "integer"
          },
          "module": {
            "type": "string"
          },
          "main_path": {
            "type": "boolean"
          },
          "duration_min": {
            "type": "integer"
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prereqs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vocab": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example_tag": {
            "type": "string"
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/section"
                }
              },
              "en": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/section"
                }
              }
            }
          },
          "diagram_svg": {
            "type": [
              "string",
              "null"
            ]
          },
          "skip_note": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "content_version": {
            "type": "integer"
          }
        }
      }
    },
    "quizzes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "lesson",
          "stage",
          "questions"
        ],
        "properties": {
          "lesson": {
            "type": "string"
          },
          "stage": {
            "type": "integer"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/question"
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "gate",
          "stage",
          "questions"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "stage": {
            "type": "integer"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/question"
            }
          }
        }
      }
    },
    "glossary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "lta/glossary.schema.json",
      "title": "glossary.yaml",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "en",
          "vi_keep",
          "vi",
          "short_vi",
          "short_en",
          "introduced_in"
        ],
        "properties": {
          "term": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "en": {
            "type": "string"
          },
          "vi_keep": {
            "type": "boolean"
          },
          "vi": {
            "type": "string"
          },
          "short_vi": {
            "type": "string",
            "maxLength": 140
          },
          "short_en": {
            "type": "string",
            "maxLength": 140
          },
          "introduced_in": {
            "type": "string",
            "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "track",
          "prereqs",
          "lessons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vi",
              "en"
            ],
            "properties": {
              "vi": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "track": {
            "type": "string"
          },
          "prereqs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}