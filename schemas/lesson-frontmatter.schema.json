{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/lesson-frontmatter.schema.json",
  "title": "Lesson frontmatter (.vi.md / .en.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lang",
    "track",
    "level",
    "stage",
    "module",
    "main_path",
    "title",
    "duration_min",
    "skills",
    "prereqs",
    "related",
    "vocab",
    "example_tag",
    "versions_used",
    "content_version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lang": {
      "type": "string",
      "enum": [
        "vi",
        "en"
      ]
    },
    "track": {
      "type": "string",
      "enum": [
        "foundation",
        "design",
        "backend",
        "frontend",
        "devops",
        "k8s",
        "management",
        "sysdesign"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "main_path": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90
    },
    "duration_min": {
      "type": "integer",
      "minimum": 6,
      "maximum": 20
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "prereqs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "vocab": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "example_tag": {
      "type": "string",
      "pattern": "^stage-[0-4]$"
    },
    "versions_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "published"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "auto",
        "owner",
        null
      ]
    }
  }
}