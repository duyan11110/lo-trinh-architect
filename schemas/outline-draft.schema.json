{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lta/outline-draft.schema.json",
  "title": "outline-<module>.draft.yaml (đầu ra prompt 01, đầu vào merge-outline)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module"
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackId": {
      "type": "string",
      "enum": [
        "foundation",
        "design",
        "backend",
        "frontend",
        "devops",
        "k8s",
        "management",
        "sysdesign"
      ]
    },
    "lessonId": {
      "type": "string",
      "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "skillId": {
      "type": "string",
      "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "term": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/skillId"
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "prereqs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/skillId"
            },
            "default": []
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "stage",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vi",
            "en"
          ],
          "properties": {
            "vi": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vi",
            "en"
          ],
          "properties": {
            "vi": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "lessons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "main_path",
              "duration_min",
              "skills",
              "prereqs",
              "vocab",
              "example_tag",
              "outline",
              "misconceptions",
              "related"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/lessonId"
              },
              "title": {
                "$ref": "#/$defs/i18n"
              },
              "main_path": {
                "type": "boolean"
              },
              "duration_min": {
                "type": "integer",
                "minimum": 6,
                "maximum": 20
              },
              "skills": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "#/$defs/skillId"
                }
              },
              "prereqs": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/lessonId"
                }
              },
              "related": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "#/$defs/lessonId"
                },
                "default": []
              },
              "vocab": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/term"
                }
              },
              "example_tag": {
                "type": "string",
                "pattern": "^stage-[0-4]$"
              },
              "example_files": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "outline": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 240
                }
              },
              "misconceptions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 200
                }
              },
              "depth_notes": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "glossary_additions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "en",
          "vi_keep",
          "vi",
          "short_vi",
          "short_en",
          "introduced_in"
        ],
        "properties": {
          "term": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "en": {
            "type": "string"
          },
          "vi_keep": {
            "type": "boolean"
          },
          "vi": {
            "type": "string"
          },
          "short_vi": {
            "type": "string",
            "maxLength": 140
          },
          "short_en": {
            "type": "string",
            "maxLength": 140
          },
          "introduced_in": {
            "type": "string",
            "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        }
      }
    },
    "repo_changes_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lesson",
          "need"
        ],
        "properties": {
          "lesson": {
            "type": "string",
            "pattern": "^(foundation|design|backend|frontend|devops|k8s|management|sysdesign)\\.l[1-4]\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "need": {
            "type": "string"
          },
          "suggested_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}