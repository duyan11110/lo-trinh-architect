#!/usr/bin/env bash
# tools/capture-output <script-path> [--ref <ref>]
#
# Thin wrapper — the real logic lives in scripts/capture-output.sh inside the
# Đơn Hàng example repo (examples/don-hang), so its own CI can run the exact
# same command. See tools/SPEC.md "capture-output".
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$DIR/.." && pwd)"
DON_HANG="$REPO_ROOT/examples/don-hang"
TARGET="$DON_HANG/scripts/capture-output.sh"

if [ ! -f "$TARGET" ]; then
  echo "scripts/capture-output.sh not found in examples/don-hang yet — repo ví dụ chưa dựng" >&2
  exit 1
fi

exec "$TARGET" "$@"
