#!/usr/bin/env bash
# Wrapper for tools/bin/validate.dart — see tools/SPEC.md.
# Deliberately does NOT `cd`: relative paths in args (--file, --repo-dir) must
# resolve against the caller's cwd, not this script's directory.
set -euo pipefail
# pwd -W first: on Git Bash/MSYS `pwd` prints /f/... which the Windows `dart`
# binary cannot open. Falls back to plain pwd everywhere else.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && { pwd -W 2>/dev/null || pwd; })"
exec dart run "$DIR/bin/validate.dart" "$@"
