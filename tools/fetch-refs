#!/usr/bin/env bash
# tools/fetch-refs — idempotently clone the reference doc repos and fetch the
# pinned RFCs into refs/. See tools/SPEC.md "fetch-refs · sync-app-content ·
# fetch-web-sqlite" and DECISIONS.md D9.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$DIR/.." && pwd)"
REFS_DIR="$REPO_ROOT/refs"
mkdir -p "$REFS_DIR/rfc"

clone_if_missing() {
  local url="$1"
  local dest_name="$2"
  local dest="$REFS_DIR/$dest_name"
  if [ -d "$dest/.git" ]; then
    echo "skip $dest_name (đã có)"
  else
    echo "clone $dest_name <- $url"
    git clone --depth 1 "$url" "$dest"
  fi
}

clone_if_missing https://github.com/dotnet/docs.git dotnet-docs
clone_if_missing https://github.com/dotnet/AspNetCore.Docs.git aspnetcore-docs
clone_if_missing https://github.com/kubernetes/website.git kubernetes-website
clone_if_missing https://github.com/docker/docs.git docker-docs
clone_if_missing https://github.com/flutter/website.git flutter-website

fetch_rfc_if_missing() {
  local n="$1"
  local dest="$REFS_DIR/rfc/rfc$n.txt"
  if [ -f "$dest" ]; then
    echo "skip rfc$n.txt (đã có)"
  else
    echo "fetch rfc$n.txt"
    curl -fsSL "https://www.rfc-editor.org/rfc/rfc$n.txt" -o "$dest"
  fi
}

fetch_rfc_if_missing 9110
fetch_rfc_if_missing 9111
fetch_rfc_if_missing 9112
fetch_rfc_if_missing 6265
# Khóa standards thêm 2026-11-09 (chủ duyệt): RFC cho claim cần nguồn.
for n in 6585 5789 2119 8174 5280 8259 3339 1034 1035 9293 768 791 8446; do
  fetch_rfc_if_missing "$n"
done

# Trang tài liệu không phải RFC (khóa versions.yaml 2026-11-09). Lưu nguyên bản
# vào refs/web/<tên>; reviewer Grep bản sao thay vì WebFetch domain chưa có.
mkdir -p "$REFS_DIR/web"
fetch_page_if_missing() {
  local name="$1" url="$2"
  local dest="$REFS_DIR/web/$name"
  if [ -f "$dest" ]; then
    echo "skip web/$name (đã có)"
  else
    echo "fetch web/$name <- $url"
    curl -fsSL -A "lo-trinh-architect-fetch-refs" "$url" -o "$dest" || { echo "LỖI web/$name"; rm -f "$dest"; }
  fi
}
fetch_page_if_missing coreutils.html https://www.gnu.org/software/coreutils/manual/coreutils.html
fetch_page_if_missing busybox.html https://busybox.net/downloads/BusyBox.html
fetch_page_if_missing nc.1.html https://man.openbsd.org/nc.1
fetch_page_if_missing ssh.1.html https://man.openbsd.org/ssh.1
fetch_page_if_missing ssh_config.5.html https://man.openbsd.org/ssh_config.5
fetch_page_if_missing ssh-keygen.1.html https://man.openbsd.org/ssh-keygen.1
fetch_page_if_missing openssl-s_client.html https://docs.openssl.org/3.5/man1/openssl-s_client/
fetch_page_if_missing openssl-x509.html https://docs.openssl.org/3.5/man1/openssl-x509/
fetch_page_if_missing postgres-image.md https://raw.githubusercontent.com/docker-library/docs/master/postgres/content.md
fetch_page_if_missing tz-theory.html https://data.iana.org/time-zones/theory.html
# W3C (trace-context, WCAG22) trả 403 cho curl; reviewer dùng WebFetch nếu chủ thêm www.w3.org vào allowlist.
fetch_page_if_missing slsa-levels.html https://slsa.dev/spec/v1.0/levels
fetch_page_if_missing slsa-terminology.html https://slsa.dev/spec/v1.0/terminology
fetch_page_if_missing cyclonedx-overview.html https://cyclonedx.org/specification/overview/
fetch_page_if_missing nist-rpo.html https://csrc.nist.gov/glossary/term/recovery_point_objective
fetch_page_if_missing nist-rto.html https://csrc.nist.gov/glossary/term/recovery_time_objective
fetch_page_if_missing cap-gilbert-lynch.pdf https://groups.csail.mit.edu/tds/papers/Gilbert/Brewer2.pdf
fetch_page_if_missing ddd-reference.pdf https://www.domainlanguage.com/wp-content/uploads/2016/05/DDD_Reference_2015-03.pdf

echo "fetch-refs xong."
