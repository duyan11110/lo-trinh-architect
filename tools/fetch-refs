#!/usr/bin/env bash
# tools/fetch-refs — idempotently clone the reference doc repos and fetch the
# pinned RFCs into refs/. See tools/SPEC.md "fetch-refs · sync-app-content ·
# fetch-web-sqlite" and DECISIONS.md D9.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$DIR/.." && pwd)"
REFS_DIR="$REPO_ROOT/refs"
mkdir -p "$REFS_DIR/rfc"

clone_if_missing() {
  local url="$1"
  local dest_name="$2"
  local dest="$REFS_DIR/$dest_name"
  if [ -d "$dest/.git" ]; then
    echo "skip $dest_name (đã có)"
  else
    echo "clone $dest_name <- $url"
    git clone --depth 1 "$url" "$dest"
  fi
}

clone_if_missing https://github.com/dotnet/docs.git dotnet-docs
clone_if_missing https://github.com/dotnet/AspNetCore.Docs.git aspnetcore-docs
clone_if_missing https://github.com/kubernetes/website.git kubernetes-website
clone_if_missing https://github.com/docker/docs.git docker-docs
clone_if_missing https://github.com/flutter/website.git flutter-website

fetch_rfc_if_missing() {
  local n="$1"
  local dest="$REFS_DIR/rfc/rfc$n.txt"
  if [ -f "$dest" ]; then
    echo "skip rfc$n.txt (đã có)"
  else
    echo "fetch rfc$n.txt"
    curl -fsSL "https://www.rfc-editor.org/rfc/rfc$n.txt" -o "$dest"
  fi
}

fetch_rfc_if_missing 9110
fetch_rfc_if_missing 9111
fetch_rfc_if_missing 9112
fetch_rfc_if_missing 6265

echo "fetch-refs xong."
