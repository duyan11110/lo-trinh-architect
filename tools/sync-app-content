#!/usr/bin/env bash
# tools/sync-app-content [--preview] — copy dist/(preview/)content.json into
# app/assets/content/ for the Flutter app. See tools/SPEC.md and DECISIONS B6.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$DIR/.." && pwd)"

PREVIEW=0
for arg in "$@"; do
  if [ "$arg" = "--preview" ]; then PREVIEW=1; fi
done

if [ "$PREVIEW" = "1" ]; then
  SRC_DIR="$REPO_ROOT/dist/preview"
else
  SRC_DIR="$REPO_ROOT/dist"
fi
SRC="$SRC_DIR/content.json"

if [ ! -f "$SRC" ]; then
  extra_flag=""
  if [ "$PREVIEW" = "1" ]; then extra_flag=" --preview"; fi
  echo "sync-app-content: $SRC not found — chạy tools/build$extra_flag trước." >&2
  exit 1
fi

if [ ! -d "$REPO_ROOT/app" ]; then
  echo "sync-app-content: app/ chưa tồn tại — chưa dựng Flutter project, bỏ qua." >&2
  exit 1
fi

DEST_DIR="$REPO_ROOT/app/assets/content"
mkdir -p "$DEST_DIR"
cp "$SRC" "$DEST_DIR/content.json"

VERSION="$(grep -o '"content_version"[^,}]*' "$SRC" | head -1 | grep -o '[0-9]\+' || echo 0)"
echo "$VERSION" > "$DEST_DIR/VERSION"

echo "sync-app-content: copied $SRC -> $DEST_DIR/content.json (VERSION=$VERSION)"
