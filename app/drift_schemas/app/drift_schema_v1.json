  "fixed_sql": [
    {
      "name": "lesson_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_progress\" (\"lesson_id\" TEXT PRIMARY KEY, \"status\" TEXT NOT NULL CHECK (status IN ('new', 'opened', 'read', 'passed')), \"first_opened_at\" TEXT, \"read_at\" TEXT, \"passed_at\" TEXT, \"best_score\" REAL, \"scroll_ratio\" REAL NOT NULL DEFAULT 0, \"prereq_warned\" INTEGER NOT NULL DEFAULT 0, \"content_version\" INTEGER);"
        }
      ]
    },
    {
      "name": "quiz_attempt",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiz_attempt\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL CHECK (kind IN ('lesson', 'module', 'review', 'gate')), \"ref_id\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT, \"score\" INTEGER, \"total\" INTEGER, \"question_ids\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "quiz_answer",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiz_answer\" (\"attempt_id\" INTEGER NOT NULL REFERENCES quiz_attempt(id)ON DELETE CASCADE, \"question_id\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"correct\" INTEGER NOT NULL, \"answered_at\" TEXT NOT NULL, \"flagged\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(attempt_id, question_id));"
        }
      ]
    },
    {
      "name": "review_item",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_item\" (\"item_id\" TEXT PRIMARY KEY, \"kind\" TEXT NOT NULL CHECK (kind IN ('question', 'term')), \"source_lesson\" TEXT, \"tier\" INTEGER NOT NULL DEFAULT 0, \"due_at\" TEXT NOT NULL, \"last_result\" INTEGER, \"times_seen\" INTEGER NOT NULL DEFAULT 0, \"retired\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "vocab_seen",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocab_seen\" (\"term\" TEXT PRIMARY KEY, \"first_lesson_id\" TEXT NOT NULL, \"seen_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "stage_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stage_progress\" (\"stage\" INTEGER PRIMARY KEY, \"gate_passed_at\" TEXT, \"best_gate_score\" REAL, \"attempts\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT PRIMARY KEY, \"value\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "event",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"event\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"ts\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"ref\" TEXT, \"value\" REAL);"
        }
      ]
    },
    {
      "name": "search_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"search_index\" USING fts5(lesson_id UNINDEXED, lang UNINDEXED, title, body, tokenize = \"unicode61 remove_diacritics 0\");"
        }
      ]
    }
  ]
